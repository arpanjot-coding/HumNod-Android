<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_humnod_large" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/HumNod.Title"
                android:text="@string/app_name"
                android:textSize="23sp" />

            <TextView
                style="@style/HumNod.Muted"
                android:text="@string/local_ai"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/models_button"
            style="@style/HumNod.OutlineButton"
            android:text="@string/models" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/chat_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/intro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="14dp">

                <TextView
                    android:id="@+id/intro_kicker"
                    style="@style/HumNod.Kicker"
                    android:text="@string/offline_setup" />

                <TextView
                    android:id="@+id/intro_title"
                    style="@style/HumNod.Title"
                    android:layout_marginTop="8dp"
                    android:text="@string/hero_title"
                    android:textSize="34sp" />

                <TextView
                    android:id="@+id/intro_detail"
                    style="@style/HumNod.Muted"
                    android:layout_marginTop="8dp"
                    android:text="@string/hero_detail" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/setup_models"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/qwen_choice"
                    layout="@layout/model_choice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/smol_choice"
                    layout="@layout/model_choice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp" />

                <include
                    android:id="@+id/gemma_choice"
                    layout="@layout/model_choice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/file_shortcut"
                style="@style/HumNod.OutlineButton"
                android:layout_marginTop="12dp"
                android:text="@string/summarize_file"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/model_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/panel_humnod"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/model_title"
                    style="@style/HumNod.Title"
                    android:text="@string/get_started"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/model_detail"
                    style="@style/HumNod.Muted"
                    android:accessibilityLiveRegion="polite"
                    android:layout_marginTop="6dp"
                    android:text="@string/get_started_detail" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/download_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:visibility="gone"
                    app:trackColor="#3B5155"
                    app:trackCornerRadius="2dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/model_action"
                    style="@style/HumNod.Button"
                    android:layout_marginTop="10dp"
                    android:text="@string/choose_model" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/exchange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/HumNod.Kicker"
                    android:text="@string/you" />

                <TextView
                    android:id="@+id/question"
                    style="@style/HumNod.Body"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/panel_humnod"
                    android:padding="16dp"
                    android:saveEnabled="false"
                    android:textIsSelectable="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/HumNod.Kicker"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/app_name" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/copy_button"
                        style="@style/HumNod.OutlineButton"
                        android:text="@string/copy_reply"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/answer"
                    style="@style/HumNod.Body"
                    android:layout_marginTop="6dp"
                    android:saveEnabled="false"
                    android:textIsSelectable="true" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/composer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/panel_humnod"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/attachment"
            style="@style/HumNod.OutlineButton"
            android:ellipsize="end"
            android:maxLines="1"
            android:visibility="gone" />

        <TextView
            android:id="@+id/attachment_notice"
            style="@style/HumNod.Muted"
            android:accessibilityLiveRegion="polite"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:textSize="13sp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:hint="@string/prompt_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences|textNoSuggestions"
            android:imeOptions="flagNoPersonalizedLearning"
            android:maxLength="1200"
            android:maxLines="3"
            android:minHeight="48dp"
            android:padding="4dp"
            android:saveEnabled="false"
            android:textColor="#E8F3F1"
            android:textColorHint="#B2C7C5"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/attach_button"
                style="@style/HumNod.OutlineButton"
                android:text="@string/attach" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mode_button"
                style="@style/HumNod.OutlineButton"
                android:layout_marginStart="4dp"
                android:text="@string/assistant_mode" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/send_button"
                style="@style/HumNod.Button"
                android:text="@string/send" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/setup_footer"
        style="@style/HumNod.Muted"
        android:gravity="center"
        android:paddingBottom="16dp"
        android:text="@string/setup_footer"
        android:textSize="13sp" />
</LinearLayout>
